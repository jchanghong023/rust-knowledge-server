-                0,
+                0 as nix::libc::c_ulong,
+                0 as nix::libc::c_ulong,
                 nix::libc::RWF_APPEND,
             )
         };
 
         usize::try_from(written).map_err(|_| io::Error::last_os_error())
     }
 
